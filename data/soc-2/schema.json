{
  "case_id": "SOC-2",
  "case_name": "Suspicious endpoint execution",
  "schema_version": "1.0.0",
  "unit_of_evaluation": "event",
  "timezone_policy": "event_time carries an explicit UTC offset; event_time_utc is the normalized UTC instant.",
  "sources": ["endpoint", "inventory", "maintenance"],
  "required_fields": [
    "event_id",
    "case_id",
    "schema_version",
    "source",
    "event_time",
    "event_time_utc",
    "sensor",
    "host",
    "account",
    "event_type",
    "outcome"
  ],
  "fields": {
    "event_id": { "type": "string", "description": "Stable unique identifier, e.g. SOC2-T-0012." },
    "case_id": { "type": "string", "description": "Always SOC-2." },
    "schema_version": { "type": "string", "description": "Schema version of the record." },
    "source": { "type": "string", "description": "endpoint, inventory, or maintenance." },
    "event_time": { "type": "string", "description": "Source timestamp with explicit offset." },
    "event_time_utc": { "type": "string", "description": "Normalized UTC instant derived from event_time." },
    "sensor": { "type": "string", "description": "Collecting sensor, e.g. edr-win-1." },
    "host": { "type": "string", "description": "Synthetic host name." },
    "account": { "type": "string", "description": "Synthetic account identity." },
    "event_type": { "type": "string", "description": "process.create, script.block, file.create, network.connect, host.info, maintenance.window." },
    "outcome": { "type": "string", "description": "success, blocked, denied, or allowed." },
    "pid": { "type": "integer", "description": "Process id; may be reused." },
    "process_guid": { "type": "string", "description": "Stable process identity." },
    "parent_guid": { "type": "string", "description": "Parent process identity, may be missing." },
    "process_name": { "type": "string", "description": "Image name." },
    "parent_name": { "type": "string", "description": "Parent image name when observed." },
    "command_line": { "type": "string", "description": "Inert command-line representation." },
    "signer": { "type": "string", "description": "Observed signer or empty for unsigned." },
    "file_path": { "type": "string", "description": "Synthetic path." },
    "dest_ip": { "type": "string", "description": "Documentation-only destination address." },
    "dest_port": { "type": "integer", "description": "Destination port." },
    "bytes": { "type": "integer", "description": "Bytes written or transferred." },
    "maintenance_id": { "type": "string", "description": "Approved maintenance record, when applicable." },
    "role": { "type": "string", "description": "Synthetic role." },
    "note": { "type": "string", "description": "Short analyst-facing context." },
    "raw": { "type": "object", "description": "Small source-shaped payload." }
  }
}
