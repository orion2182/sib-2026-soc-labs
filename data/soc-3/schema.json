{
  "case_id": "SOC-3",
  "case_name": "DNS and network beacon",
  "schema_version": "1.0.0",
  "unit_of_evaluation": "event",
  "timezone_policy": "event_time carries an explicit UTC offset; event_time_utc is the normalized UTC instant.",
  "sources": ["dns", "conn", "ids"],
  "required_fields": [
    "event_id",
    "case_id",
    "schema_version",
    "source",
    "event_time",
    "event_time_utc",
    "sensor",
    "host",
    "account",
    "event_type",
    "outcome"
  ],
  "fields": {
    "event_id": { "type": "string", "description": "Stable unique identifier, e.g. SOC3-T-0007." },
    "case_id": { "type": "string", "description": "Always SOC-3." },
    "schema_version": { "type": "string", "description": "Schema version of the record." },
    "source": { "type": "string", "description": "dns, conn, or ids." },
    "event_time": { "type": "string", "description": "Source timestamp with explicit offset." },
    "event_time_utc": { "type": "string", "description": "Normalized UTC instant derived from event_time." },
    "sensor": { "type": "string", "description": "Sensor id, e.g. zeek-dns-1." },
    "host": { "type": "string", "description": "Synthetic host name." },
    "account": { "type": "string", "description": "Synthetic account identity." },
    "event_type": { "type": "string", "description": "dns.query, conn.flow, ids.alert." },
    "outcome": { "type": "string", "description": "success, allowed, denied, or no_answer." },
    "query": { "type": "string", "description": "DNS query name." },
    "qtype": { "type": "string", "description": "DNS query type." },
    "rcode": { "type": "string", "description": "DNS response code." },
    "answers": { "type": "string", "description": "Comma-separated answer addresses." },
    "dest_ip": { "type": "string", "description": "Documentation-only destination address." },
    "dest_port": { "type": "integer", "description": "Destination port." },
    "proto": { "type": "string", "description": "Transport protocol." },
    "duration": { "type": "number", "description": "Flow duration in seconds." },
    "orig_bytes": { "type": "integer", "description": "Bytes from the host." },
    "resp_bytes": { "type": "integer", "description": "Bytes to the host." },
    "flow_id": { "type": "string", "description": "Stable flow reference." },
    "signature": { "type": "string", "description": "IDS signature text." },
    "category": { "type": "string", "description": "IDS category." },
    "severity": { "type": "integer", "description": "IDS severity 1-3." },
    "process_name": { "type": "string", "description": "Observed process context, when available." },
    "role": { "type": "string", "description": "Synthetic role." },
    "note": { "type": "string", "description": "Short analyst-facing context." },
    "raw": { "type": "object", "description": "Small source-shaped payload." }
  }
}
